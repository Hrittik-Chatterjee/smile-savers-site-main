---
/**
 * Badge — the pill-shaped "content-type" / "hero-badge" / "persona-badge"
 * markup that was copy-pasted across 7 files in the programmatic-SEO route
 * family, independently found broken three different ways (DDR-011) because
 * each copy could drift on its own. All 5 "eyebrow" copies and both "pill"
 * copies were byte-identical CSS by the time this was extracted — this
 * component is that CSS, written once.
 *
 * variant="eyebrow": small, uppercase, text-only (was `.content-type`).
 * variant="pill": medium, icon + text via slot (was `.hero-badge` /
 *   `.persona-badge`) — pass the icon SVG as the first slotted child.
 */
interface Props {
  variant?: 'eyebrow' | 'pill';
  class?: string;
}
const { variant = 'eyebrow', class: className = '' } = Astro.props;
---

<span class:list={['badge', `badge-${variant}`, className]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    background: var(--color-brand-surface-subtle);
    color: var(--color-primary-dark);
    border-radius: var(--radius-full);
    margin-bottom: 1rem;
  }
  .badge-eyebrow {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .badge-pill {
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }
</style>
